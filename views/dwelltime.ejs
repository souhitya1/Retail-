<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Dwell Time Analytics</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        rel="stylesheet"
        href="/css/dwelltime.css">

</head>

<body>

<div class="container py-4">

    <h1 class="text-center mb-4">
        Dwell Time Analytics
    </h1>


    <!-- Zone Controls -->

    <div class="card p-3 mb-4">

        <div class="row">

            <div class="col-md-5">

                <label class="form-label">
                    Section Name
                </label>

                <input
                    type="text"
                    id="zoneName"
                    class="form-control"
                    value="Coke">

            </div>


            <div class="col-md-7 d-flex align-items-end gap-2">

                <button
                    id="startCamera"
                    class="btn btn-primary">

                    Start Camera

                </button>


                <button
                    id="drawZone"
                    class="btn btn-success">

                    Draw Zone

                </button>


                <button
                    id="clearZone"
                    class="btn btn-danger">

                    Clear

                </button>

            </div>

        </div>

    </div>


    <!-- Camera -->

    <div class="camera-container">

        <video
            id="video"
            autoplay
            playsinline
            muted>
        </video>

        <canvas id="canvas"></canvas>

    </div>


    <!-- Zone Information -->

    <div class="card mt-4 p-3">

        <h4>Zone Information</h4>

        <p id="zoneStatus">
            Camera not started.
        </p>

        <pre id="zoneData"></pre>

    </div>


    <!-- Dwell Information -->

    <div class="row mt-4">

        <div class="col-md-4">

            <div class="card p-3 text-center">

                <h5>Current Status</h5>

                <h3 id="personStatus">
                    Empty
                </h3>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card p-3 text-center">

                <h5>Current Dwell Time</h5>

                <h3>
                    <span id="dwellSeconds">0</span>
                    sec
                </h3>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card p-3 text-center">

                <h5>Coke Visitors</h5>

                <h3 id="visitorCount">
                    0
                </h3>

            </div>

        </div>

    </div>

</div>


<script src="/js/dwelltime.js"></script>

</body>

</html>