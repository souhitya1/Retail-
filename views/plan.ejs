<% layout("layout/boilerplate") -%>

<link rel="stylesheet" href="/css/plan.css">

<div class="plans-page">

    <!-- Background Glow -->
    <div class="bg-glow glow-one"></div>
    <div class="bg-glow glow-two"></div>

<!-- Hero -->
    <section class="plans-hero">

    

        <h1>
            Choose the right plan<br>
            <span>for your store.</span>
        </h1>

        <p>
            Start using AI-powered retail analytics to understand
            customers, inventory and billing counters.
        </p>

    </section>


    <!-- Pricing Cards -->
    <section class="pricing-section">

        <!-- 1 Month -->
        <div class="plan-card">

            <div class="plan-top">
                <div class="plan-icon">
                    ⚡
                </div>

                <span class="duration">
                    1 MONTH
                </span>
            </div>

            <h2>Starter</h2>

            <p class="plan-description">
                Perfect for trying RetailAI in your store.
            </p>

            <div class="price">
                <span class="currency">₹</span>
                <span class="amount">1,399</span>
            </div>

            <p class="price-period">
                for 1 month
            </p>

            <div class="divider"></div>

            <ul class="features">
                <li>
                    <span>✓</span>
                    Customer counting
                </li>

                <li>
                    <span>✓</span>
                    Inventory management
                </li>

                <li>
                    <span>✓</span>
                    Shelf monitoring
                </li>

                <li>
                    <span>✓</span>
                    Retail dashboard
                </li>
            </ul>

            <button class="choose-btn">
                Choose Plan
                <span>→</span>
            </button>

        </div>


        <!-- 3 Months -->
        <div class="plan-card">

            <div class="plan-top">
                <div class="plan-icon">
                    📊
                </div>

                <span class="duration">
                    3 MONTHS
                </span>
            </div>

            <h2>Growth</h2>

            <p class="plan-description">
                A better option for growing retail stores.
            </p>

            <div class="price">
                <span class="currency">₹</span>
                <span class="amount">3,999</span>
            </div>

            <p class="price-period">
                ₹1,333 / month
            </p>

            <div class="divider"></div>

            <ul class="features">
                <li>
                    <span>✓</span>
                    Everything in Starter
                </li>

                <li>
                    <span>✓</span>
                    Product detection
                </li>

                <li>
                    <span>✓</span>
                    Dwell-time analytics
                </li>

                <li>
                    <span>✓</span>
                    Counter monitoring
                </li>
            </ul>

            <button class="choose-btn">
                Choose Plan
                <span>→</span>
            </button>

        </div>


        <!-- 6 Months -->
        <div class="plan-card popular-plan">

            <div class="popular-badge">
                MOST POPULAR
            </div>

            <div class="plan-top">
                <div class="plan-icon">
                    🚀
                </div>

                <span class="duration">
                    6 MONTHS
                </span>
            </div>

            <h2>Business</h2>

            <p class="plan-description">
                Built for stores that want deeper analytics.
            </p>

            <div class="price">
                <span class="currency">₹</span>
                <span class="amount">7,499</span>
            </div>

            <p class="price-period">
                ₹1,250 / month
            </p>

            <div class="divider"></div>

            <ul class="features">
                <li>
                    <span>✓</span>
                    Everything in Growth
                </li>

                <li>
                    <span>✓</span>
                    Advanced customer analytics
                </li>

                <li>
                    <span>✓</span>
                    Section visitor analytics
                </li>

                <li>
                    <span>✓</span>
                    Multiple billing counters
                </li>
            </ul>

            <button class="choose-btn primary-btn">
                Choose Plan
                <span>→</span>
            </button>

        </div>


        <!-- 12 Months -->
        <div class="plan-card best-plan">

            <div class="best-value">
                BEST VALUE
            </div>

            <div class="plan-top">
                <div class="plan-icon">
                    👑
                </div>

                <span class="duration">
                    12 MONTHS
                </span>
            </div>

            <h2>Enterprise</h2>

            <p class="plan-description">
                Complete RetailAI experience for your store.
            </p>

            <div class="price">
                <span class="currency">₹</span>
                <span class="amount">13,999</span>
            </div>

            <p class="price-period">
                ₹1,167 / month
            </p>

            <div class="divider"></div>

            <ul class="features">
                <li>
                    <span>✓</span>
                    Everything in Business
                </li>

                <li>
                    <span>✓</span>
                    Full AI retail analytics
                </li>

                <li>
                    <span>✓</span>
                    Inventory & shelf insights
                </li>

                <li>
                    <span>✓</span>
                    Priority support
                </li>
            </ul>

            <button class="choose-btn primary-btn">
                Choose Plan
                <span>→</span>
            </button>

        </div>

    </section>


    <!-- Comparison / Value Section -->
    <section class="value-section">

        <div class="value-content">

            <div class="value-badge">
                SAVE MORE
            </div>

            <h2>
                The longer you stay,
                <span>the more you save.</span>
            </h2>

            <p>
                Get access to RetailAI analytics for a longer period
                and reduce your effective monthly cost.
            </p>

        </div>


        <div class="saving-card">

            <div class="saving-row">
                <span>1 Month</span>
                <strong>₹1,399/mo</strong>
            </div>

            <div class="saving-row">
                <span>3 Months</span>
                <strong>₹1,333/mo</strong>
            </div>

            <div class="saving-row">
                <span>6 Months</span>
                <strong>₹1,250/mo</strong>
            </div>

            <div class="saving-row highlight-row">
                <span>
                    <strong>12 Months</strong>
                    <small>Best Value</small>
                </span>

                <strong>₹1,167/mo</strong>
            </div>

        </div>

    </section>


    <!-- CTA -->
    <section class="plans-cta">

        <div class="cta-content">

            <div class="cta-icon">
                ✦
            </div>

            <h2>
                Ready to make your store smarter?
            </h2>

            <p>
                Choose a RetailAI plan and start turning
                your store data into useful insights.
            </p>

            <a href="/retail/dashboard" class="dashboard-btn">
                Go to Dashboard
                <span>→</span>
            </a>

        </div>

    </section>


    <!-- Footer -->
    <footer class="plans-footer">

        <div class="footer-brand">
            <strong>Retail<span>AI</span></strong>
            <p>Intelligent Retail Analytics</p>
        </div>

        <p>
            © <%= new Date().getFullYear() %> RetailAI. All rights reserved.
        </p>

    </footer>
</div>