<% layout("layout/boilerplate") -%>

<link rel="stylesheet" href="/css/inventory.css">

<div class="inventory-page">

    <!-- Background Effects -->
    <div class="inventory-glow glow-left"></div>
    <div class="inventory-glow glow-right"></div>


    <!-- PAGE HEADER -->

    <section class="inventory-header">

        <div>

            <h1>
                Store <span>Inventory</span>
            </h1>

            <p>
                Monitor your products, stock levels and inventory value
                from one place.
            </p>
        </div>


        <a href="/retail/inventory/new" class="add-product-btn">
            <span>+</span>
            Add Product
        </a>

    </section>


    <!-- SUMMARY CARDS -->

    <section class="inventory-stats">

        <!-- Total Products -->

        <div class="stat-card">

            <div class="stat-icon blue-icon">
                📦
            </div>

            <div class="stat-info">
                <span>Total Products</span>

                <strong>
                    <%= items.length %>
                </strong>

                <small>
                    Products in inventory
                </small>
            </div>

        </div>


        <!-- Total Stock -->

        <div class="stat-card">

            <div class="stat-icon cyan-icon">
                📊
            </div>

            <div class="stat-info">

                <span>Total Stock</span>

                <strong>
                    <%= items.reduce((total, item) => total + Number(item.quantity || 0), 0) %>
                </strong>

                <small>
                    Units available
                </small>

            </div>

        </div>


        <!-- Low Stock -->

        <div class="stat-card">

            <div class="stat-icon orange-icon">
                ⚠
            </div>

            <div class="stat-info">

                <span>Low Stock</span>

                <strong class="warning-number">
                    <%= items.filter(item => Number(item.quantity || 0) <= Number(item.lowStockThreshold || 5)).length %>
                </strong>

                <small>
                    Need attention
                </small>

            </div>

        </div>


        <!-- Inventory Value -->

        <div class="stat-card">

            <div class="stat-icon green-icon">
                ₹
            </div>

            <div class="stat-info">

                <span>Inventory Value</span>

                <strong>
                    ₹<%= items.reduce((total, item) => total + (Number(item.quantity || 0) * Number(item.price || 0)), 0).toLocaleString("en-IN") %>
                </strong>

                <small>
                    Current stock value
                </small>

            </div>

        </div>

    </section>


    <!-- INVENTORY CONTAINER -->

    <section class="inventory-container">


        <!-- TOOLBAR -->

        <div class="inventory-toolbar">

            <div class="toolbar-title">

                <h2>Products</h2>

                <span>
                    <%= items.length %> items
                </span>

            </div>


            <div class="toolbar-actions">

                <!-- Search -->

                <div class="search-box">

                    <span>⌕</span>

                    <input
                        type="text"
                        id="searchInput"
                        placeholder="Search products..."
                    >

                </div>


                <!-- Category -->

                <select id="categoryFilter">

                    <option value="all">
                        All Categories
                    </option>

                    <% 
                        const categories = [...new Set(
                            items.map(item => item.category).filter(Boolean)
                        )];
                    %>

                    <% categories.forEach(category => { %>

                        <option value="<%= category.toLowerCase() %>">
                            <%= category %>
                        </option>

                    <% }) %>

                </select>

            </div>

        </div>


        <!-- TABLE -->

        <% if (items.length === 0) { %>

            <div class="empty-inventory">

                <div class="empty-icon">
                    📦
                </div>

                <h3>
                    No products yet
                </h3>

                <p>
                    Add your first product to start managing your inventory.
                </p>

                <a
                    href="/retail/inventory/new"
                    class="add-product-btn">
                    + Add Product
                </a>

            </div>

        <% } else { %>


            <div class="table-wrapper">

                <table class="inventory-table">

                    <thead>

                        <tr>

                            <th>
                                PRODUCT
                            </th>

                            <th>
                                CATEGORY
                            </th>

                            <th>
                                STOCK
                            </th>

                            <th>
                                PRICE
                            </th>

                            <th>
                                THRESHOLD
                            </th>

                            <th>
                                STATUS
                            </th>

                            <th>
                                ACTION
                            </th>

                        </tr>

                    </thead>


                    <tbody id="inventoryTableBody">

                        <% items.forEach(item => { %>

                            <%
                                const quantity = Number(item.quantity || 0);
                                const threshold = Number(item.lowStockThreshold || 5);

                                let status = "In Stock";

                                if (quantity === 0) {
                                    status = "Out of Stock";
                                } else if (quantity <= threshold) {
                                    status = "Low Stock";
                                }
                            %>


                            <tr
                                class="inventory-row"
                                data-name="<%= item.productName.toLowerCase() %>"
                                data-category="<%= (item.category || '').toLowerCase() %>"
                            >


                                <!-- PRODUCT -->

                                <td>

                                    <div class="product-info">

                                        <div class="product-icon">
                                            <%= item.productName.charAt(0).toUpperCase() %>
                                        </div>

                                        <div>

                                            <strong>
                                                <%= item.productName %>
                                            </strong>

                                            <small>
                                                <%= item.unit || "Unit" %>
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- CATEGORY -->

                                <td>

                                    <span class="category-badge">
                                        <%= item.category || "Other" %>
                                    </span>

                                </td>


                                <!-- STOCK -->

                                <td>

                                    <div class="stock-value">

                                        <strong>
                                            <%= quantity %>
                                        </strong>

                                        <span>
                                            <%= item.unit || "units" %>
                                        </span>

                                    </div>

                                </td>


                                <!-- PRICE -->

                                <td>

                                    <strong class="price">
                                        ₹<%= Number(item.price || 0).toLocaleString("en-IN") %>
                                    </strong>

                                </td>


                                <!-- THRESHOLD -->

                                <td>

                                    <span class="threshold">
                                        <%= threshold %>
                                    </span>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    <% if (status === "In Stock") { %>

                                        <span class="stock-status in-stock">
                                            <span></span>
                                            In Stock
                                        </span>

                                    <% } else if (status === "Low Stock") { %>

                                        <span class="stock-status low-stock">
                                            <span></span>
                                            Low Stock
                                        </span>

                                    <% } else { %>

                                        <span class="stock-status out-stock">
                                            <span></span>
                                            Out of Stock
                                        </span>

                                    <% } %>

                                </td>


                                <!-- ACTION -->

                                <td>

                                    <div class="action-buttons">

                                        <a
                                            href="/retail/inventory/<%= item._id %>/edit"
                                            class="edit-btn"
                                            title="Edit">
                                            ✎
                                        </a>


                                        <form
                                            action="/retail/inventory/<%= item._id %>/delete"
                                            method="POST"
                                            onsubmit="return confirm('Are you sure you want to delete this product?');">

                                            <button
                                                type="submit"
                                                class="delete-btn"
                                                title="Delete">
                                                ×
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        <% } %>

    </section>


    <!-- AI INVENTORY INSIGHT -->

    <section class="inventory-insight">

        <div class="insight-icon">
            ✦
        </div>

        <div class="insight-content">

            <span>
                RETAILAI INSIGHT
            </span>

            <h3>
                Smart inventory monitoring
            </h3>

            <p>
                RetailAI can use shelf-space detection and product
                recognition to identify potential stock-outs and
                help you replenish products faster.
            </p>

        </div>

    </section>


</div>


<script>

    const searchInput = document.getElementById("searchInput");
    const categoryFilter = document.getElementById("categoryFilter");
    const rows = document.querySelectorAll(".inventory-row");


    function filterInventory() {

        const searchValue =
            searchInput.value.toLowerCase().trim();

        const categoryValue =
            categoryFilter.value;


        rows.forEach(row => {

            const name =
                row.dataset.name;

            const category =
                row.dataset.category;


            const matchesSearch =
                name.includes(searchValue);

            const matchesCategory =
                categoryValue === "all" ||
                category === categoryValue;


            if (matchesSearch && matchesCategory) {

                row.style.display = "";

            } else {

                row.style.display = "none";

            }

        });

    }


    searchInput.addEventListener(
        "input",
        filterInventory
    );


    categoryFilter.addEventListener(
        "change",
        filterInventory
    );

</script>