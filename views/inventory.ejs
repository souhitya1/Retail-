<% layout("layout/boilerplate") -%>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Inventory</h2>
    <a href="/retail/inventory/new" class="btn btn-primary">+ Add Product</a>
  </div>

  <table class="table table-hover align-middle">
    <thead>
      <tr>
        <th>Product</th>
        <th>Category</th>
        <th>Quantity</th>
        <th>Price (₹)</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(item => { %>
        <tr>
          <td><%= item.productName %></td>
          <td><%= item.category %></td>
          <td><%= item.quantity %> <%= item.unit %></td>
          <td>₹<%= item.price %></td>
          <td>
            <% if (item.quantity === 0) { %>
              <span class="badge bg-danger">Out of Stock</span>
            <% } else if (item.quantity <= item.lowStockThreshold) { %>
              <span class="badge bg-warning text-dark">Low Stock</span>
            <% } else { %>
              <span class="badge bg-success">In Stock</span>
            <% } %>
          </td>
          <td>
            <a href="/retail/inventory/<%= item._id %>/edit" class="btn btn-sm btn-outline-primary me-1">Edit</a>
            <form action="/retail/inventory/<%= item._id %>/delete" method="POST" onsubmit="return confirm('Delete this product?');">
              <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (items.length === 0) { %>
        <tr><td colspan="6" class="text-center text-muted py-4">No inventory items yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>