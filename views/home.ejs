<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>RetailAI | Intelligent Retail Analytics</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Google Font -->
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/home.css">
</head>

<body>
        <% layout("layout/boilerplate") -%>
<section class="hero">

    <div class="hero-glow glow-one"></div>
    <div class="hero-glow glow-two"></div>

    <div class="container">

        <div class="row align-items-center">

            <!-- LEFT -->

            <div class="col-lg-6 hero-content">

                

                <h1>
                    Smarter Stores.
                    <span>Better Decisions.</span>
                </h1>

                <p class="hero-text">
                    Transform your retail store with real-time computer
                    vision and edge AI. Monitor customers, shelves,
                    products and billing counters from one intelligent
                    platform.
                </p>

                <div class="hero-buttons">

                    <a href="/retail/login" class="primary-btn">
                        Open Dashboard
                        <span>→</span>
                    </a>

                    <a href="#features" class="secondary-btn">
                        Explore Features
                    </a>

                </div>

                <div class="hero-stats">

                    <div>
                        <strong>AI</strong>
                        <small>Powered</small>
                    </div>

                    <div>
                        <strong>Real-Time</strong>
                        <small>Analytics</small>
                    </div>

                    <div>
                        <strong>Edge</strong>
                        <small>Computing</small>
                    </div>

                </div>

            </div>


            <!-- RIGHT DASHBOARD MOCKUP -->

            <div class="col-lg-6">

                <div class="dashboard-preview">

                    <div class="preview-header">

                        <div>
                            <div class="live-dot"></div>
                            LIVE STORE CAMERA
                        </div>

                        <span>● ONLINE</span>

                    </div>


                    <div class="camera-screen">

                        <div class="camera-grid"></div>

                        <!-- Person 1 -->

                        <div class="person person-one">

                            <div class="bounding-box"></div>

                            <div class="label">
                                PERSON
                            </div>

                        </div>


                        <!-- Person 2 -->

                        <div class="person person-two">

                            <div class="bounding-box"></div>

                            <div class="label">
                                PERSON
                            </div>

                        </div>


                        <!-- Product -->

                        <div class="product-box">

                            <div class="product-label">
                                COKE
                            </div>

                        </div>


                        <!-- Shelf -->

                        <div class="shelf-area">

                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>

                        </div>

                    </div>


                    <!-- ANALYTICS -->

                    <div class="analytics-row">

                        <div class="analytics-card">

                            <span class="analytics-icon">👥</span>

                            <div>
                                <small>People</small>
                                <strong>12</strong>
                            </div>

                        </div>


                        <div class="analytics-card">

                            <span class="analytics-icon">📦</span>

                            <div>
                                <small>Stock</small>
                                <strong>92%</strong>
                            </div>

                        </div>


                        <div class="analytics-card">

                            <span class="analytics-icon">🛒</span>

                            <div>
                                <small>Queue</small>
                                <strong>4 / 5</strong>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- ================= FEATURES ================= -->

<section class="features-section" id="features">

    <div class="container">

        <div class="section-heading">

            <div class="section-tag">
                CORE CAPABILITIES
            </div>

            <h2>
                Everything Your Store Needs
            </h2>

            <p>
                One intelligent system to understand what's happening
                inside your store.
            </p>

        </div>


        <div class="row g-4">

            <!-- Card -->

            <div class="col-md-6 col-lg-3">

                <div class="feature-card">

                    <div class="feature-icon">
                        👥
                    </div>

                    <h4>Customer Analytics</h4>

                    <p>
                        Monitor customer footfall, entry, exit and
                        dwell time inside different store zones.
                    </p>

                    <a href="#">
                        Learn more →
                    </a>

                </div>

            </div>


            <!-- Card -->

            <div class="col-md-6 col-lg-3">

                <div class="feature-card">

                    <div class="feature-icon">
                        📦
                    </div>

                    <h4>Smart Inventory</h4>

                    <p>
                        Detect empty shelf spaces and identify
                        products using computer vision.
                    </p>

                    <a href="#">
                        Learn more →
                    </a>

                </div>

            </div>


            <!-- Card -->

            <div class="col-md-6 col-lg-3">

                <div class="feature-card">

                    <div class="feature-icon">
                        🛒
                    </div>

                    <h4>Queue Intelligence</h4>

                    <p>
                        Monitor billing counters and compare
                        real-time people with counter capacity.
                    </p>

                    <a href="#">
                        Learn more →
                    </a>

                </div>

            </div>


            <!-- Card -->

            <div class="col-md-6 col-lg-3">

                <div class="feature-card">

                    <div class="feature-icon">
                        📊
                    </div>

                    <h4>Live Dashboard</h4>

                    <p>
                        View important retail metrics and make
                        faster, data-driven decisions.
                    </p>

                    <a href="#">
                        Learn more →
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- ================= HOW IT WORKS ================= -->

<section class="how-section" id="how-it-works">

    <div class="container">

        <div class="section-heading">

            <div class="section-tag">
                HOW IT WORKS
            </div>

            <h2>
                From Camera to Insight
            </h2>

            <p>
                Our system converts camera footage into useful
                retail intelligence.
            </p>

        </div>


        <div class="workflow">

            <div class="workflow-step">

                <div class="step-number">
                    01
                </div>

                <div class="step-icon">
                    📷
                </div>

                <h4>Capture</h4>

                <p>
                    Camera captures real-time store activity.
                </p>

            </div>


            <div class="workflow-line"></div>


            <div class="workflow-step">

                <div class="step-number">
                    02
                </div>

                <div class="step-icon">
                    🧠
                </div>

                <h4>Analyze</h4>

                <p>
                    AI models analyze people, products and shelves.
                </p>

            </div>


            <div class="workflow-line"></div>


            <div class="workflow-step">

                <div class="step-number">
                    03
                </div>

                <div class="step-icon">
                    ⚡
                </div>

                <h4>Process</h4>

                <p>
                    Edge computing processes data with low latency.
                </p>

            </div>


            <div class="workflow-line"></div>


            <div class="workflow-step">

                <div class="step-number">
                    04
                </div>

                <div class="step-icon">
                    📊
                </div>

                <h4>Insights</h4>

                <p>
                    Dashboard provides actionable store insights.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- ================= TECHNOLOGY ================= -->

<section class="technology-section" id="technology">

    <div class="container">

        <div class="tech-box">

            <div>

                <div class="section-tag">
                    BUILT WITH MODERN TECHNOLOGY
                </div>

                <h2>
                    Edge AI for Real-World Retail
                </h2>

                <p>
                    Designed to process computer vision workloads
                    close to the store, reducing dependency on
                    constant internet connectivity.
                </p>

            </div>


            <div class="tech-stack">

                <span>YOLO</span>
                <span>OpenCV</span>
                <span>Raspberry Pi</span>
                <span>Python</span>
                <span>Node.js</span>
                <span>MongoDB</span>

            </div>

        </div>

    </div>

</section>


<!-- ================= CTA ================= -->

<section class="cta-section">

    <div class="container">

        <div class="cta-box">

            <div class="cta-glow"></div>

            <h2>
                Ready to Build a Smarter Store?
            </h2>

            <p>
                Start monitoring your store with AI-powered
                retail analytics.
            </p>

            <a href="/retail/signup" class="primary-btn">
                Get Started →
            </a>

        </div>

    </div>

</section>


<!-- ================= FOOTER ================= -->

<footer>

    <div class="container">

        <div class="footer-content">

            <div class="logo">
                <span class="logo-icon">R</span>
                Retail<span>AI</span>
            </div>

            <p>
                Intelligent Retail Analytics System
            </p>

            <p class="copyright">
                © 2026 RetailAI. All rights reserved.
            </p>

        </div>

    </div>

</footer>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>